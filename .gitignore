# ==============================================================================
# Gitignore for Tang Nano 20K RISC-V SoC Project
# ==============================================================================

# Gowin EDA Build Artifacts & Logs
impl/
temp/
*.fs
*.bin
*.db
*.log
*.rpt
*.power.html
*.timing.html
*.tr.html
*.vo
*.vhm
*.vhd.tmp
*.v.tmp
*.fs.bin
*.gprj.user
*.bin.gz
*.posp
*.id

# Simulation Artifacts (ModelSim, Questa, Icarus, Verilator, VCS)
*.vcd
*.fst
*.fsdb
*.wlf
work/
simv*
*.vvp
/sim_spi
/sim_soc
/tb_soc_top_sim
csrc/
*.daidir/
obj_dir/
*.log
dump.vcd

# Software Build Artifacts (Bare-metal RISC-V Toolchain)
sw/*.o
sw/*.elf
sw/*.bin
sw/*.hex
sw/*.dis
sw/*.map
*.d

# OS & Editor Artifacts
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
.vscode/
.idea/
*.sublime-workspace
*.bak

# Markdown: publish project documentation; keep ad-hoc notes local.
# Put public technical documents in docs/ and personal notes in progress/.
*.md
!README.md
!/docs/**/*.md
!LICENSE.md
!CONTRIBUTING.md
!CHANGELOG.md
!SECURITY.md
!CODE_OF_CONDUCT.md

# Private plans, journals, agent configuration, and local credentials
/PLAN.md
/progress/
/notes/
/.agents/
/.codex/
/.aws/
.env
.env.*
!.env.example
