# Keep the vendored copy byte-identical to upstream, and out of the language statistics.
third_party/** -text linguist-vendored

# These run under Linux or WSL, and CRLF breaks them on a Windows checkout.
*.sh text eol=lf
sw/Makefile text eol=lf

# The ROM image stays byte-identical, whatever the checkout's line endings.
sw/firmware.hex -text
